# ===== 密钥（不要提交）=====
# LLM：任意 OpenAI 兼容服务；地址与模型在 config.yaml 的 llm 段配置
LLM_API_KEY=your_deepseek_key_here
# 高德 Web 服务 Key（仅网关使用）
AMAP_WEB_SERVICE_KEY=your_amap_web_service_key_here
AMAP_JS_KEY=your_amap_js_key_here   # 仅 example/runAmapExample.js 使用

# ===== Node 网关 =====
PORT=3000
AGENT_BASE=http://127.0.0.1:8002

# Neo4j（本地 Docker 容器）
NEO4J_PASSWORD=change_me
