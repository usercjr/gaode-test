# ===== 密钥（不要提交）=====
# LLM：任意 OpenAI 兼容服务；地址与模型在 config.yaml 的 llm 段配置
LLM_API_KEY=your_deepseek_key_here
# 高德 Web 服务 Key（仅网关使用）
AMAP_WEB_SERVICE_KEY=your_amap_web_service_key_here
# 高德 JS API Key 与安全密钥（地图页使用，由网关 /api/config 下发到浏览器）
AMAP_JS_KEY=your_amap_js_key_here
AMAP_JS_SECURITY_CODE=your_amap_js_security_code_here

# ===== Node 网关 =====
PORT=3000
AGENT_BASE=http://127.0.0.1:8002
# 监控页 /admin.html 与 /api/metrics：设置后凭 token 访问；不设置时只允许本机访问（Docker 部署时必须设置）
ADMIN_TOKEN=
# 限流：每个 IP 每分钟的请求数（0 表示不限）；重请求 = 规划 / 聊天 / 问答
RATE_LIMIT_API_PER_MIN=120
RATE_LIMIT_HEAVY_PER_MIN=10
# 过载保护：同时进行的重请求上限，超过直接返回“当前使用人数较多”
HEAVY_MAX_IN_FLIGHT=8

# Neo4j（本地 Docker 容器）
NEO4J_PASSWORD=change_me
# Docker 部署（可选）：指向本机已下载的 HuggingFace 模型缓存，避免容器首次启动重新下载
# HF_CACHE_DIR=C:/Users/you/.cache/huggingface
